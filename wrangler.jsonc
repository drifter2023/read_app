// Mobile web build on Cloudflare: a Worker that only serves the static files in dist/.
// Deploy with `npm run deploy:web`. Headers (service-worker caching) come from public/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spotlight-reader",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
