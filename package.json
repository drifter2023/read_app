{
  "name": "spotlight",
  "private": true,
  "type": "module",
  "scripts": {
    "books": "node scripts/build-books.ts",
    "dict": "node --no-warnings=ExperimentalWarning scripts/build-dict.ts",
    "assets": "npm run books && npm run dict",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "e2e": "playwright test",
    "build:ios": "npm run build && npx cap sync ios",
    "build:ios:dev": "VITE_DEV_TOOLS=1 npm run build && npx cap sync ios",
    "deploy:web": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0"
  }
}
